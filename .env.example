# Copia este archivo como .env (nunca lo subas a Git) y completa los valores.
#
# OpenStreetMap no usa claves de API. Lo importante es identificarte con un
# User-Agent válido ante Nominatim y Overpass, como exigen sus políticas de
# uso, y dejar un contacto real antes de desplegar.

# Identificación de la aplicación (recomendado; obligatorio en producción).
# Formato sugerido: NombreApp/version (+URL; contact: correo)
OSM_USER_AGENT=ExperienciaSV/1.0 (+https://tu-dominio.example; contact: tu-correo@example.com)

# Endpoints públicos de OpenStreetMap (opcional; por defecto estos).
# El Overpass público puede estar al límite de capacidad. Para uso continuado,
# configura una instancia propia o de confianza. El chat limita las búsquedas
# por categoría a 10 s y no las reintenta; las búsquedas por nombre usan
# Nominatim.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Intervalo mínimo entre solicitudes a Nominatim, en milisegundos.
# La política de uso pide 1 solicitud por segundo: no lo bajes en producción.
NOMINATIM_MIN_INTERVAL_MS=1100

# Teselas del mapa (opcional). Por defecto, el servidor de teselas de OSM.
# Con más tráfico conviene un proveedor propio o comercial. Debe usar HTTPS
# y contener {z}, {x} e {y}.
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Atribución que se dibuja en el mapa. Debe mantener la de OpenStreetMap.
OSM_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Puerto del servidor de API local (opcional, por defecto 8787).
API_PORT=8787

# Origen autorizado para el API (opcional).
# Si se define, las solicitudes con un encabezado Origin distinto reciben 403.
# Ejemplo en producción: https://experiencia-sv.vercel.app
ALLOWED_ORIGIN=

# ── Asistente con IA (Fase 4) ────────────────────────────────────────────────
# La clave vive SOLO en el servidor. No uses variables VITE_* para secretos.
# Sin AI_API_KEY, /api/chat responde AI_NOT_CONFIGURED y el resto de la app
# sigue funcionando con OpenStreetMap. No se simula una IA como sustituto.
#
# El cliente usa la API compatible con OpenAI Chat Completions. Puedes cambiar
# de proveedor con estas variables, sin tocar código. Ejemplos de base URL:
#   OpenAI:     https://api.openai.com/v1
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
#   DeepSeek:   https://api.deepseek.com/v1
#   Ollama:     http://localhost:11434/v1  (elige un AI_MODEL instalado)
#
# Solo se permite HTTPS; HTTP se acepta únicamente para localhost/127.0.0.1/::1.
# Ollama no usa clave real, pero este servidor exige un valor no vacío para
# habilitar el chat: por ejemplo, AI_API_KEY=local.
# Los planes gratuitos de algunos proveedores limitan solicitudes por minuto o
# por día; la app responde AI_RATE_LIMITED o AI_UNAVAILABLE, no inventa datos.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_PROVIDER_NAME=OpenAI

# Tiempo máximo por llamada al proveedor (3000–25000 ms; por defecto 15000).
# El presupuesto total del turno se controla con CHAT_TIMEOUT_MS.
AI_TIMEOUT_MS=15000
# Máximo de tokens de salida por llamada (200–2000; por defecto 900).
AI_MAX_OUTPUT_TOKENS=900
# Esfuerzo de razonamiento opcional: low, medium o high. Reduce la latencia en
# modelos que razonan antes de responder (por ejemplo Gemini 3). Vacío = valor
# predeterminado del proveedor.
AI_REASONING_EFFORT=

# Secreto para firmar el itinerario que viaja al navegador (mínimo 16
# caracteres, aleatorio). Recomendado en producción. Si no se define, se deriva
# de AI_API_KEY; si esa clave rota, los itinerarios abiertos dejan de validarse.
# No lo expongas, no lo subas a Git y no lo pases al navegador.
CHAT_SIGNING_SECRET=

# Límites del chat (opcionales; entre paréntesis el valor por defecto).
# CHAT_RATE_LIMIT_PER_MINUTE=12    # solicitudes por IP y minuto
# CHAT_SESSION_LIMIT_PER_MINUTE=8  # solicitudes por sessionId y minuto
# CHAT_MAX_CONCURRENT=2            # solicitudes simultáneas por instancia
# CHAT_MAX_TOOL_CALLS=5            # herramientas por turno (1–6)
# CHAT_MAX_SEARCHES=3              # search_places por turno (1–4)
# CHAT_MAX_LOCATES=2               # locate_reference por turno (1–3)
# CHAT_TIMEOUT_MS=27000            # presupuesto del turno (10000–29000)
# CHAT_ITINERARY_TTL_MS=43200000   # validez del token: 12 h (máx. 7 días)

# ── Supabase: cuentas e itinerarios guardados (Fase 5) ──────────────────────
# Estas dos variables son PÚBLICAS por diseño: Vite las incluye en el bundle
# del navegador. La protección real de los datos son las políticas RLS de
# supabase/migrations/. Sin estas variables, la exploración y el chat siguen
# funcionando, pero las cuentas y los itinerarios guardados quedan desactivados.
#
# 1. Crea un proyecto en https://supabase.com/
# 2. Copia la URL del proyecto (Project Settings > API).
# 3. Copia la clave publicable/anon (nunca la service_role).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable
# Alternativa para proyectos que ya usan las claves nuevas de Supabase. Si
# VITE_SUPABASE_ANON_KEY está vacía, se acepta esta variable publicable.
# VITE_SUPABASE_PUBLISHABLE_KEY=

# IMPORTANTE: nunca pongas SUPABASE_SERVICE_ROLE_KEY en el frontend ni en una
# variable VITE_*. Esa clave omite RLS y solo puede usarse en un backend de
# confianza. Esta aplicación no la necesita.
#
# Cambiar estas variables exige reiniciar Vite en desarrollo y volver a
# compilar/desplegar en producción. Los redirects de Auth se configuran en
# Supabase (Authentication > URL Configuration) además de en supabase/config.toml
# para el entorno local.

